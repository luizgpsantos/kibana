{
  "processors": [
    {
      "redact": {
        "field": "message",
        "patterns": [
          "%{EMAILADDRESS:EMAIL}",
          "(?i)(?=[aAcCdDpPuUeEvV])(?:account number|card|cc #|ccn|credit|dankort|debit|pan|pcn|union pay|electron|visa)[^0-9A-Za-z]{0,30}+\\K%{VISA:VISA}",
          "(?i)(?=[aAcCdDpPuUmM])(?:account number|card|cc #|ccn|credit|dankort|debit|pan|pcn|union pay|mastercard|mc)[^0-9A-Za-z]{0,30}+\\K%{MASTERCARD:MASTERCARD}",
          "(?i)(?=[aAcCdDpPuU])(?:account number|card|cc #|ccn|credit|dankort|debit|pan|pcn|union pay|american express|amex)[^0-9A-Za-z]{0,30}+\\K%{AMEX:AMEX}",
          "(?i)(?=[aAcCdDpPuU])(?:account number|card|cc #|ccn|credit|dankort|debit|pan|pcn|union pay|discover)[^0-9A-Za-z]{0,30}+\\K%{DISCOVER:DISCOVER}",
          "(?i)(?=[aAcCdDpPuUmM])(?:account number|card|cc #|ccn|credit|dankort|debit|pan|pcn|union pay|diners club|mastercard|mc)[^0-9A-Za-z]{0,30}+\\K%{DINERS:DINERS}",
          "(?i)(?=[aAcCdDpPuUjJ])(?:account number|card|cc #|ccn|credit|dankort|debit|pan|pcn|union pay|jcb)[^0-9A-Za-z]{0,30}+\\K%{JCB:JCB}",
          "(?i)(?=[aAcCdDpPuUmM])(?:account number|card|cc #|ccn|credit|dankort|debit|pan|pcn|union pay|mastercard|mc)[^0-9A-Za-z]{0,30}+\\K%{MAESTRO:MAESTRO}",
          "(?i)(?=[aAbBcCdDiIsS])(?:account code|account number|accountno#|accountnumber#|bank account|bank acct|bban|checking account|checking acct|chequing account|chequing acct|customer account id|deposit account|deposit acct|iban|savings account|savings acct|sepa)[^0-9A-Za-z]{0,30}+\\K%{IBAN:IBAN}",
          "(?i)(?=[sS])(?:social security|ssn)[^0-9A-Za-z]{0,30}+\\K%{US_SSN:US_SSN}",
          "%{IPV4:IPV4}",
          "%{IPV6:IPV6}",
          "%{MAC_ADDR:MAC_ADDR}"
        ],
        "pattern_definitions": {
          "VISA": "(?<![0-9])4[ .-]?(?:[0-9][ .-]?){11,17}[0-9](?![0-9])",
          "MASTERCARD": "(?<![0-9])(?:5[1-5][ .-]?(?:[0-9][ .-]?){13}[0-9]|(?:222[1-9]|22[3-9][0-9]|2[3-6][0-9]{2}|27[01][0-9]|2720)[ .-]?(?:[0-9][ .-]?){11}[0-9])(?![0-9])",
          "AMEX": "(?<![0-9])3[47][ .-]?(?:[0-9][ .-]?){12}[0-9](?![0-9])",
          "DISCOVER": "(?<![0-9])(?:6011[ .-]?(?:[0-9][ .-]?){11}[0-9]|65[ .-]?(?:[0-9][ .-]?){13}[0-9]|64[4-9][ .-]?(?:[0-9][ .-]?){12}[0-9])(?![0-9])",
          "DINERS": "(?<![0-9])(?:3(?:0[0-5]|[68][0-9])[ .-]?(?:[0-9][ .-]?){10}[0-9]|3[0689][ .-]?(?:[0-9][ .-]?){11}[0-9])(?![0-9])",
          "JCB": "(?<![0-9])35(?:2[89]|[3-8][0-9])[ .-]?(?:[0-9][ .-]?){11}[0-9](?![0-9])",
          "MAESTRO": "(?<![0-9])(?:6304|6759|676[123])[ .-]?(?:[0-9][ .-]?){7,14}[0-9](?![0-9])",
          "IBAN": "(?<![A-Za-z0-9])(?:[A-Za-z]{2}[0-9]{2}[A-Za-z0-9]{11,30}|[A-Za-z]{2}[0-9]{2}(?: [A-Za-z0-9]{4})+(?: [A-Za-z0-9]{1,3})?)(?![A-Za-z0-9])",
          "US_SSN": "(?<![0-9])[0-9]{3}[- ]?[0-9]{2}[- ]?[0-9]{4}(?![0-9])",
          "MAC_ADDR": "(?<![0-9A-Fa-f:])(?:[0-9A-Fa-f]{2}[:\\-.]){5}[0-9A-Fa-f]{2}(?![0-9A-Fa-f:])"
        },
        "ignore_missing": true,
        "description": "Redact sensitive data (combined, structural detectors)"
      }
    }
  ]
}
